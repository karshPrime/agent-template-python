#!/usr/bin/env bash
# Project tasks. CI runs --format-dry-run, --build, --test and --release.

set -euo pipefail
cd "$(dirname "$0")"

package="{{ module_slug }}"

usage() {
    cat <<USAGE
Usage: ./run.sh <option>

  --build            install the locked dependencies and byte-compile the package
  --format           format the Python sources in place
  --format-dry-run   list unformatted Python sources and fail if there are any
  --test             run the tests
  --release          build the wheel and sdist into dist/
USAGE
}

build() {
    uv sync --locked
    uv run --locked python -m compileall -q "$package"
}

format() {
    uv run --locked ruff format .
}

format_dry_run() {
    uv run --locked ruff format --check .
}

run_tests() {
    uv run --locked pytest
}

release() {
    rm -rf dist
    uv build --out-dir dist
}

case "${1:-}" in
    --build)          build ;;
    --format)         format ;;
    --format-dry-run) format_dry_run ;;
    --test)           run_tests ;;
    --release)        release ;;
    -h|--help)        usage ;;
    *)                usage >&2; exit 1 ;;
esac
